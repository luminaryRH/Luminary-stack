# Server environment (Vercel Production, and .env.local for scripts). Names only — never commit values.
DATABASE_URL=            # Supabase Postgres (the server rewrites :5432 to the 6543 transaction pooler)
SUPABASE_URL=
OPERATOR_PRIVATE_KEY=    # hot operator key: scheduler, association-root poster and relayer (owns nothing)
CRON_SECRET=             # bearer secret for /api/cron/*
RPC_URL=                 # Robinhood Chain mainnet RPC (a paid endpoint, e.g. Alchemy; default: the public RPC)
FEE_SECRET=              # derives fee-note blindings
FEE_OWNER=
SEAL_KEY=                # order-sealing private key (1-of-1 committee, see SECURITY.md)
SEAL_PUBLIC=
COMMITTEE=               # optional: threshold committee config (members run scripts/committee-member.ts)
CHAINALYSIS_API_KEY=     # sanctions screening of depositors (free key: public.chainalysis.com); without it nobody new is approved
ALERT_WEBHOOK_URL=       # optional: monitoring alerts (Telegram/Slack-compatible JSON webhook)
GH_TOKEN=                # local only: fine-grained token for scripts/publish-public.mjs
